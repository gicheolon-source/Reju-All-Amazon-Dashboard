# ── DB ────────────────────────────────────────────────────────────────
# 로컬 개발:  file:./data/ads.db
# Vercel:     libsql://<db>-<org>.turso.io  (+ TURSO_AUTH_TOKEN)
TURSO_DATABASE_URL=file:./data/ads.db
TURSO_AUTH_TOKEN=

# ── Google Sheets (서비스 계정) ─────────────────────────────────────────
# 로컬은 키 파일 경로 하나로 충분
REJUALL_SA_KEY=C:/Users/USER/Downloads/impactful-name-495400-k2-3baa40b785b7.json
# Vercel 은 파일을 못 올리므로 값 2개로 넣는다
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── 대시보드 접근 ───────────────────────────────────────────────────────
DASH_PASSWORD=
# 세션 쿠키 서명용 랜덤 문자열 (openssl rand -hex 32)
DASH_SECRET=
